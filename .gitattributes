* text=auto eol=lf

*.cs       text diff=csharp
*.csproj   text
*.sln      text eol=crlf
*.props    text
*.targets  text
*.json     text
*.yml      text
*.yaml     text
*.md       text
*.xaml     text

*.png      binary
*.jpg      binary
*.ico      binary
*.tcx      binary
*.gpx      binary
*.mbtiles  binary
*.pbf      binary
*.sqlite   binary
*.db       binary

# Large dragon source/candidate assets live under data/ (Maya bundles, model
# variants, source archives, raw audio). Versioned via Git LFS, scoped to data/
# so the app's small runtime assets in src/.../Resources/Raw stay normal blobs.
data/*.glb     filter=lfs diff=lfs merge=lfs -text
data/**/*.glb  filter=lfs diff=lfs merge=lfs -text
data/*.zip     filter=lfs diff=lfs merge=lfs -text
data/**/*.zip  filter=lfs diff=lfs merge=lfs -text
data/*.mp3     filter=lfs diff=lfs merge=lfs -text
data/**/*.mp3  filter=lfs diff=lfs merge=lfs -text
data/*.tif     filter=lfs diff=lfs merge=lfs -text
data/**/*.tif  filter=lfs diff=lfs merge=lfs -text
data/*.ma      filter=lfs diff=lfs merge=lfs -text
data/**/*.ma   filter=lfs diff=lfs merge=lfs -text
data/*.exr     filter=lfs diff=lfs merge=lfs -text
data/**/*.exr  filter=lfs diff=lfs merge=lfs -text
data/*.hdr     filter=lfs diff=lfs merge=lfs -text
data/**/*.hdr  filter=lfs diff=lfs merge=lfs -text
