<Project Sdk="Microsoft.NET.Sdk">

	<!-- Narzędzie prebake orto (ARCHITEKTURA-STREAMING §8 + ANEKS A): WebP → strony BC1 w pakietach .opk
	     + indeks warstwy. Konsolowe, poza runtime'em — runtime NIGDY nie pisze .opk. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MapaTur.Application\MapaTur.Application.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Dekod WebP; ta sama wersja co w MapaTur.App (SkiaSharp.Views.Maui.Controls 3.119.4 → SkiaSharp 3.119.4). -->
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

</Project>
