<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:vm="clr-namespace:MapaTur.App.ViewModels"
             xmlns:loc="clr-namespace:MapaTur.App.Localization"
             xmlns:views="clr-namespace:MapaTur.App.Views"
             xmlns:markers="clr-namespace:MapaTur.Application.Markers;assembly=MapaTur.Application"
             x:Class="MapaTur.App.Views.MapPage"
             x:DataType="vm:MapPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static loc:AppStrings.AppTitle}">

    <!-- Immersive single-cell layout: the 3D map fills the whole page; the premium "frosted glass" menu
         (top bar + section panels) and the marker card float on top as overlays. The on-screen camera pad
         and altitude buttons live inside Terrain3DView and are intentionally left untouched. -->
    <Grid>

        <mapsui:MapControl x:Name="MapControl"
                           Map="{Binding Map}"
                           IsVisible="{Binding Is3DMode, Converter={StaticResource InverseBool}}"
                           SemanticProperties.Description="{x:Static loc:AppStrings.AccessibilityMapControl}" />

        <views:Terrain3DView x:Name="TerrainView"
                             Tiles="{Binding TerrainTiles}"
                             Raster="{Binding TerrainRaster}"
                             Trails="{Binding Trails3DOverlay}"
                             Roads="{Binding Roads3DOverlay}"
                             Route="{Binding Route3DOverlay}"
                             ClimbingAreas="{Binding Climbing3DOverlay}"
                             Pois="{Binding Pois3DOverlay}"
                             Peaks="{Binding Peaks3DOverlay}"
                             OrthoTexturePath="{Binding OrthoTexturePath}"
                             OrthoTexturePaths="{Binding OrthoTexturePaths}"
                             OrthoTextureCells="{Binding OrthoTextureCells}"
                             UserLocation="{Binding UserLocation}"
                             Atmosphere="{Binding Atmosphere}"
                             ForestDensity="{Binding EffectiveForestDensity}"
                             ShowOrtho="{Binding ShowOrtho}"
                             ShowPeakNames="{Binding ShowPeakNames}"
                             SlopeMapEnabled="{Binding SlopeMapMode}"
                             MsaaEnabled="{Binding AntiAliasingOn}"
                             DebugEnabled="{Binding ShowDebugOverlay}"
                             CameraState="{Binding CameraState, Mode=TwoWay}"
                             IsFlying="{Binding Is3DFlying}"
                             IsVisible="{Binding Is3DMode}" />

        <!-- Dim scrim behind an open section so the glass panel reads as a layer above the map. Soft, so
             the terrain still shows. Tap anywhere off the panel to close. Only present while a section is
             open (ActiveSection > 0). -->
        <Grid x:Name="Scrim" BackgroundColor="#4D05070C" Opacity="0"
              IsVisible="{Binding ActiveSection, Converter={StaticResource IntToBool}}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSectionCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- ════════════════════ PREMIUM MENU OVERLAY (top) ════════════════════ -->
        <!-- Hidden during a cinematic fly-through so nothing covers the scene. -->
        <VerticalStackLayout x:Name="MenuOverlay"
                             VerticalOptions="Start" HorizontalOptions="Fill"
                             Margin="10,48,10,0" Spacing="10"
                             IsVisible="{Binding Is3DFlying, Converter={StaticResource InverseBool}}">

            <!-- Debug HUD: live render stats, shown above the bar when the debug toggle is on. -->
            <Border Style="{StaticResource GlassBar}" Padding="12,6" HorizontalOptions="Center"
                    IsVisible="{Binding ShowDebugOverlay}">
                <Label Text="{Binding Source={x:Reference TerrainView}, Path=DebugStats}"
                       Style="{StaticResource GlassCaption}" FontSize="12" TextColor="{StaticResource GlassAccent}" />
            </Border>

            <!-- ── Top command bar: 5 section chips ── -->
            <Border Style="{StaticResource GlassBar}" Padding="6,5" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2">

                    <!-- 🗺️ Mapa -->
                    <Grid Grid.Column="0" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="1" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🗺️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="Mapa" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 🌦️ Pogoda -->
                    <Grid Grid.Column="1" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="2" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🌦️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="Pogoda" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 🎥 Widok -->
                    <Grid Grid.Column="2" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="3" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=3}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🎥" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="Widok" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 📍 Dane -->
                    <Grid Grid.Column="3" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="4" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=4}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="📍" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="Dane" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- ⚙️ Ustawienia -->
                    <Grid Grid.Column="4" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="5" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=5}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="⚙️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="Ustawienia" Style="{StaticResource GlassCaption}" FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Section panels (one visible at a time) ── -->

            <!-- 🗺️ MAPA -->
            <Border x:Name="PanelMapa" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🗺️  Mapa" Style="{StaticResource GlassTitle}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Ortofotomapa" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowOrtho}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Nazwy szczytów" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowPeakNames}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="Mapa nachylenia" Style="{StaticResource GlassLabel}" />
                            <Label Text="kolor wg stromości stoku (lawinowa)" Style="{StaticResource GlassCaption}" FontSize="10" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding SlopeMapMode}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Szlaki turystyczne" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowTrails}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Drogi" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowRoads}" />
                    </Grid>

                    <Label Text="KOLORY SZLAKÓW" Style="{StaticResource GlassCaption}" Margin="0,2,0,0" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourRedEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CCDC2626|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailRed" /></Border.GestureRecognizers>
                            <Label Text="Czerwony" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourBlueEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CC2563EB|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailBlue" /></Border.GestureRecognizers>
                            <Label Text="Niebieski" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourGreenEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CC16A34A|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailGreen" /></Border.GestureRecognizers>
                            <Label Text="Zielony" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourYellowEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CCEAB308|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailYellow" /></Border.GestureRecognizers>
                            <Label Text="Żółty" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourBlackEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CC111111|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailBlack" /></Border.GestureRecognizers>
                            <Label Text="Czarny" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>

                    <Label Text="REGIONY" Style="{StaticResource GlassCaption}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionTatryEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionTatry" /></Border.GestureRecognizers>
                            <Label Text="Tatry" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionBeskidyEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionBeskidy" /></Border.GestureRecognizers>
                            <Label Text="Beskidy" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionPieninyEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionPieniny" /></Border.GestureRecognizers>
                            <Label Text="Pieniny" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionBieszczadyEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionBieszczady" /></Border.GestureRecognizers>
                            <Label Text="Bieszczady" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>

                    <Border Padding="12,9" StrokeThickness="1" Stroke="#3536E2FF" Margin="0,2,0,0"
                            Background="#2236E2FF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding LoadTatraRegionCommand}" /></Border.GestureRecognizers>
                        <Label Text="⛰️  Wczytaj teren 1 m (Tatry · GUGiK)" Style="{StaticResource GlassLabel}"
                               FontSize="13" HorizontalOptions="Center" />
                    </Border>

                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10" Margin="0,2,0,0">
                        <Label Grid.Column="0" Text="Las" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding ForestDensity, Mode=TwoWay}" SemanticProperties.Hint="Gęstość lasu" />
                        <Label Grid.Column="2" Text="{Binding ForestDensity, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 🌦️ POGODA -->
            <Border x:Name="PanelPogoda" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="🌦️  Pogoda" Style="{StaticResource GlassTitle}" />
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Czas" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="24"
                                Value="{Binding TimeOfDayHours, Mode=TwoWay}" SemanticProperties.Hint="Pora dnia" />
                        <Label Grid.Column="2" Text="{Binding TimeOfDayHours, Converter={StaticResource HoursToClock}}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Chmury" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Cloudiness, Mode=TwoWay}" SemanticProperties.Hint="Zachmurzenie" />
                        <Label Grid.Column="2" Text="{Binding Cloudiness, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Wiatr" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Wind, Mode=TwoWay}" SemanticProperties.Hint="Siła wiatru" />
                        <Label Grid.Column="2" Text="{Binding Wind, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Śnieg" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Snow, Mode=TwoWay}" SemanticProperties.Hint="Pokrywa śnieżna" />
                        <Label Grid.Column="2" Text="{Binding Snow, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 🎥 WIDOK -->
            <Border x:Name="PanelWidok" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=3}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="🎥  Widok" Style="{StaticResource GlassTitle}" />
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Pion" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="1" Maximum="5"
                                Value="{Binding VerticalExaggeration, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.LabelVerticalExaggeration}" />
                        <Label Grid.Column="2" Text="{Binding VerticalExaggeration, StringFormat='{0:F1}×'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Style="{StaticResource GlassButton}" Text="⟲  Reset kamery" Clicked="OnResetCameraClicked" />
                        <Button Grid.Column="1" Style="{StaticResource GlassButtonAccent}" Text="🎬  Fly-through" Clicked="OnFlyThroughClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 📍 DANE -->
            <Border x:Name="PanelDane" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=4}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📍  Dane" Style="{StaticResource GlassTitle}" />

                    <Button Style="{StaticResource GlassButtonAccent}"
                            Text="{Binding IsLocationTracking, Converter={StaticResource LocationTrackingLabel}}"
                            Command="{Binding ToggleLocationTrackingCommand}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Planowanie trasy" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding IsRoutePlanningMode, Mode=TwoWay}" />
                    </Grid>

                    <Label Text="PUNKTY (POI)" Style="{StaticResource GlassCaption}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowHuts, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiHuts" /></Border.GestureRecognizers>
                            <Label Text="Schroniska" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowWildernessHuts, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiWilderness" /></Border.GestureRecognizers>
                            <Label Text="Bacówki" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowChalets, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiChalets" /></Border.GestureRecognizers>
                            <Label Text="Chaty" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowShelters, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiShelters" /></Border.GestureRecognizers>
                            <Label Text="Wiaty" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowViewpoints, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiViewpoints" /></Border.GestureRecognizers>
                            <Label Text="Widoki" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>

                    <Label Text="POBIERZ DLA WIDOKU" Style="{StaticResource GlassCaption}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadTrails}"
                                Command="{Binding DownloadTrailsForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadRoads}"
                                Command="{Binding DownloadRoadsForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadClimbing}"
                                Command="{Binding DownloadClimbingForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadPois}"
                                Command="{Binding DownloadPoisForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <Label Text="TRASA" Style="{StaticResource GlassCaption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.ClearRoute}"
                                Command="{Binding ClearRouteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.ExportGpx}"
                                Command="{Binding ExportRouteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ⚙️ USTAWIENIA (backend wired in a later stage) -->
            <Border x:Name="PanelUstawienia" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=5}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="⚙️  Ustawienia" Style="{StaticResource GlassTitle}" />

                    <Label Text="JAKOŚĆ RENDERINGU" Style="{StaticResource GlassCaption}" />
                    <Border Padding="4" BackgroundColor="#14FFFFFF" StrokeThickness="1" Stroke="#22FFFFFF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Grid Grid.Column="0" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectQualityCommand}" CommandParameter="0" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding RenderQuality, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="Wydajność" Style="{StaticResource GlassLabel}" FontSize="12" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                            <Grid Grid.Column="1" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectQualityCommand}" CommandParameter="1" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding RenderQuality, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="Zbalansowana" Style="{StaticResource GlassLabel}" FontSize="12" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                            <Grid Grid.Column="2" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectQualityCommand}" CommandParameter="2" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding RenderQuality, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="Wysoka" Style="{StaticResource GlassLabel}" FontSize="12" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Label Text="Wydajność wyłącza antyaliasing i przerzedza las dla większej płynności; Wysoka renderuje pełnię."
                           Style="{StaticResource GlassCaption}" />

                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,2" />

                    <Label Text="PAMIĘĆ PODRĘCZNA" Style="{StaticResource GlassCaption}" />
                    <Label Text="{Binding CacheSummary}" Style="{StaticResource GlassLabel}" FontSize="12" />
                    <Button Style="{StaticResource GlassButton}" Text="🗑  Wyczyść pobrane dane"
                            Command="{Binding ClearCacheCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,2" />

                    <Label Text="DEBUG" Style="{StaticResource GlassCaption}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Nakładka FPS / statystyki" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowDebugOverlay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Szczegółowe logi" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding VerboseLogging}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Busy + status: a slim frosted pill, only while something is loading. -->
            <Border Style="{StaticResource GlassBar}" Padding="14,8" HorizontalOptions="Center"
                    IsVisible="{Binding IsBusy}">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource GlassAccent}"
                                       WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}" Style="{StaticResource GlassCaption}" MaximumWidthRequest="280" LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Marker details card: styled popup shown when a POI / climbing marker is tapped. -->
        <Grid IsVisible="{Binding IsMarkerPopupVisible}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMarkerPopupCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource GlassSurface}" HorizontalOptions="Center" VerticalOptions="Center"
                    Margin="24" Padding="0"
                    MinimumWidthRequest="280" MaximumWidthRequest="420">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding MarkerPopupTitle}" Style="{StaticResource GlassTitle}" FontSize="17" />
                        <Button Grid.Column="1" Text="✕" FontSize="15" Padding="0"
                                WidthRequest="34" HeightRequest="34" CornerRadius="17"
                                BackgroundColor="#1FFFFFFF" TextColor="{StaticResource GlassInk}"
                                Command="{Binding CloseMarkerPopupCommand}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#22FFFFFF" />
                    <VerticalStackLayout Padding="18,12" Spacing="8"
                                         BindableLayout.ItemsSource="{Binding MarkerPopupLines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="markers:MarkerPopupLine">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource GlassCaption}" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding Value}" Style="{StaticResource GlassLabel}" FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
