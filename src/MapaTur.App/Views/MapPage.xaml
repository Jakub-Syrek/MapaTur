<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:vm="clr-namespace:MapaTur.App.ViewModels"
             xmlns:loc="clr-namespace:MapaTur.App.Localization"
             xmlns:views="clr-namespace:MapaTur.App.Views"
             xmlns:markers="clr-namespace:MapaTur.Application.Markers;assembly=MapaTur.Application"
             xmlns:routing="clr-namespace:MapaTur.Domain.Routing;assembly=MapaTur.Domain"
             x:Class="MapaTur.App.Views.MapPage"
             x:Name="PageRoot"
             x:DataType="vm:MapPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static loc:AppStrings.AppTitle}">

    <!-- Immersive single-cell layout: the 3D map fills the whole page; the premium "frosted glass" menu
         (top bar + section panels) and the marker card float on top as overlays. The on-screen camera pad
         and altitude buttons live inside Terrain3DView and are intentionally left untouched. -->
    <Grid>

        <mapsui:MapControl x:Name="MapControl"
                           Map="{Binding Map}"
                           IsVisible="{Binding Is3DMode, Converter={StaticResource InverseBool}}"
                           SemanticProperties.Description="{x:Static loc:AppStrings.AccessibilityMapControl}" />

        <views:Terrain3DView x:Name="TerrainView"
                             Tiles="{Binding TerrainTiles}"
                             Raster="{Binding TerrainRaster}"
                             DetailElevation="{Binding DetailElevation}"
                             Trails="{Binding Trails3DOverlay}"
                             Roads="{Binding Roads3DOverlay}"
                             Route="{Binding Route3DOverlay}"
                             ClimbingAreas="{Binding Climbing3DOverlay}"
                             Pois="{Binding Pois3DOverlay}"
                             Peaks="{Binding Peaks3DOverlay}"
                             OrthoTexturePath="{Binding OrthoTexturePath}"
                             OrthoTexturePaths="{Binding OrthoTexturePaths}"
                             OrthoTextureCells="{Binding OrthoTextureCells}"
                             UserLocation="{Binding UserLocation}"
                             Atmosphere="{Binding Atmosphere}"
                             ShowOrtho="{Binding ShowOrtho}"
                             LodOrthoCoverageBounds="{Binding LodOrthoCoverageBounds}"
                             LodDetailBounds="{Binding LodDetailBounds}"
                             ShowPeakNames="{Binding ShowPeakNames}"
                             ShowNightSky="{Binding ShowNightSky}"
                             ShowContours="{Binding ShowContours}"
                             PeakLabelRadiusMeters="{Binding PeakLabelRadiusMeters}"
                             ControlsVisible="{Binding ChromeVisible}"
                             SlopeMapEnabled="{Binding SlopeMapMode}"
                             RockMaterialEnabled="{Binding RockMaterialOn}"
                             BiomeMaterialEnabled="{Binding BiomeMaterialOn}"
                             MsaaEnabled="{Binding AntiAliasingOn}"
                             DebugEnabled="{Binding ShowDebugOverlay}"
                             CameraState="{Binding CameraState, Mode=TwoWay}"
                             IsFlying="{Binding Is3DFlying}"
                             IsVisible="{Binding Is3DMode}" />

        <!-- Dim scrim behind an open section so the glass panel reads as a layer above the map. Soft, so
             the terrain still shows. Tap anywhere off the panel to close. Only present while a section is
             open (ActiveSection > 0). -->
        <Grid x:Name="Scrim" BackgroundColor="#4D05070C" Opacity="0"
              IsVisible="{Binding ActiveSection, Converter={StaticResource IntToBool}}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSectionCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- ════════════════════ PREMIUM MENU OVERLAY (top) ════════════════════ -->
        <!-- Hidden during a cinematic fly-through so nothing covers the scene. -->
        <VerticalStackLayout x:Name="MenuOverlay"
                             VerticalOptions="Start" HorizontalOptions="Fill"
                             Margin="10,48,10,0" Spacing="10"
                             IsVisible="{Binding ChromeVisible}">

            <!-- Debug HUD: live render stats, shown above the bar when the debug toggle is on. -->
            <Border Style="{StaticResource GlassBar}" Padding="12,6" HorizontalOptions="Center"
                    IsVisible="{Binding ShowDebugOverlay}">
                <Label Text="{Binding Source={x:Reference TerrainView}, Path=DebugStats}"
                       Style="{StaticResource GlassCaption}" FontSize="12" TextColor="{StaticResource GlassAccent}" />
            </Border>

            <!-- ── Top command bar: 6 section chips ── -->
            <Border Style="{StaticResource GlassBar}" Padding="6,5" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="2">

                    <!-- 🧭 Trasa -->
                    <Grid Grid.Column="0" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="1" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🧭" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="{x:Static loc:AppStrings.TabRoute}" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 🎚️ Tryby -->
                    <Grid Grid.Column="1" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="2" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🎚️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="{x:Static loc:AppStrings.TabModes}" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 🎥 Widok -->
                    <Grid Grid.Column="2" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="3" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=3}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🎥" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="{x:Static loc:AppStrings.TabView}" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 🗺️ Mapa -->
                    <Grid Grid.Column="3" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="4" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=4}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🗺️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="{x:Static loc:AppStrings.TabMap}" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 🌦️ Pogoda -->
                    <Grid Grid.Column="4" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="5" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=5}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🌦️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="{x:Static loc:AppStrings.TabWeather}" Style="{StaticResource GlassCaption}" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- ⚙️ Ustawienia -->
                    <Grid Grid.Column="5" Padding="2,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSectionCommand}" CommandParameter="6" />
                        </Grid.GestureRecognizers>
                        <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=6}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        </Border>
                        <VerticalStackLayout Spacing="1" Padding="0,4" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="⚙️" FontSize="19" HorizontalOptions="Center" />
                            <Label Text="{x:Static loc:AppStrings.TabSettings}" Style="{StaticResource GlassCaption}" FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Always-visible find-me / teleport bar (independent of the active section and of route
                 planning): recenter on the live GPS fix, toggle tracking, or jump the camera to any named
                 place. Reuses the existing PlaceQuery / PlaceResults / TeleportToPlaceCommand bindings. -->
            <Border Style="{StaticResource GlassSurface}" Padding="16,12">
                <VerticalStackLayout Spacing="10">
                    <!-- Tap the header to collapse / expand this search + location bar. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.LocateBarHeader}" Style="{StaticResource GlassCaption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="▾" Style="{StaticResource GlassLabel}" FontSize="14" VerticalOptions="Center"
                               IsVisible="{Binding IsLocateBarExpanded}" />
                        <Label Grid.Column="1" Text="▸" Style="{StaticResource GlassLabel}" FontSize="14" VerticalOptions="Center"
                               IsVisible="{Binding IsLocateBarExpanded, Converter={StaticResource InverseBool}}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleLocateBarCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsLocateBarExpanded}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Style="{StaticResource GlassButtonAccent}"
                                Text="{x:Static loc:AppStrings.LocateCenterOnMe}"
                                Command="{Binding CenterOnMeCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource GlassButtonAccent}"
                                Text="{Binding IsLocationTracking, Converter={StaticResource LocationTrackingLabel}}"
                                Command="{Binding ToggleLocationTrackingCommand}" />
                    </Grid>
                    <Border Style="{StaticResource GlassBar}" Padding="10,2">
                        <Entry Placeholder="{x:Static loc:AppStrings.TeleportPlaceholder}" Text="{Binding PlaceQuery, Mode=TwoWay}"
                               TextColor="White" PlaceholderColor="#88FFFFFF" BackgroundColor="Transparent" />
                    </Border>
                    <CollectionView ItemsSource="{Binding PlaceResults}" HeightRequest="150" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="routing:RouteWaypoint">
                                <Grid Padding="8,7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource GlassLabel}"
                                           FontSize="13" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ElevationMeters, StringFormat='{0:F0} m'}"
                                           Style="{StaticResource GlassCaption}" FontSize="11" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="{x:Static loc:AppStrings.TeleportFly}" FontSize="12" Padding="8,2" Margin="0"
                                            BackgroundColor="#3336E2FF" TextColor="White" CornerRadius="10"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.TeleportToPlaceCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ── Section panels (one visible at a time) ── -->

            <!-- 🧭 TRASA -->
            <Border x:Name="PanelTrasa" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                <ScrollView MaximumHeightRequest="600">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static loc:AppStrings.SectionRouteTitle}" Style="{StaticResource GlassTitle}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.RoutePlanningLabel}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding IsRoutePlanningMode, Mode=TwoWay}" />
                    </Grid>

                    <!-- Tourist-map route builder: pick named stops from the searchable list (or tap them on
                         the map); they form an ordered chain routed leg-by-leg over the trails. Visible only
                         while planning is on. -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRoutePlanningMode}">
                        <Label Text="{x:Static loc:AppStrings.AddStopHeader}" Style="{StaticResource GlassCaption}" />
                        <Border Style="{StaticResource GlassBar}" Padding="10,2">
                            <Entry Placeholder="{x:Static loc:AppStrings.SearchPlaceholder}" Text="{Binding PlaceQuery, Mode=TwoWay}"
                                   TextColor="White" PlaceholderColor="#88FFFFFF" BackgroundColor="Transparent" />
                        </Border>

                        <CollectionView ItemsSource="{Binding PlaceResults}" HeightRequest="168"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="routing:RouteWaypoint">
                                    <Grid Padding="8,7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddStopCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource GlassLabel}"
                                               FontSize="13" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ElevationMeters, StringFormat='{0:F0} m'}"
                                               Style="{StaticResource GlassCaption}" FontSize="11" VerticalOptions="Center" />
                                        <Button Grid.Column="2" Text="{x:Static loc:AppStrings.TeleportFly}" FontSize="12" Padding="8,2" Margin="0"
                                                BackgroundColor="#3336E2FF" TextColor="White" CornerRadius="10"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.TeleportToPlaceCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="{x:Static loc:AppStrings.RouteStopsHeader}" Style="{StaticResource GlassCaption}" />
                        <!-- Drag ⠿ to reorder the stops (designs the route order); ReorderCompleted re-plans.
                             Each stop is a card with the name, elevation and a delete chip. -->
                        <CollectionView ItemsSource="{Binding RouteStops}" HeightRequest="200" SelectionMode="None"
                                        CanReorderItems="True" ReorderCompleted="OnRouteStopsReorderCompleted">
                            <CollectionView.EmptyView>
                                <Label Text="{x:Static loc:AppStrings.RouteStopsEmpty}"
                                       Style="{StaticResource GlassCaption}" FontSize="11" Padding="4,6" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="routing:RouteWaypoint">
                                    <Border Padding="11,9" Margin="0,0,0,6" StrokeThickness="1" Stroke="#3036E2FF" Background="#1F36E2FF">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                            <Label Grid.Column="0" Text="⠿" FontSize="18" TextColor="#9936E2FF" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource GlassLabel}"
                                                       FontSize="14" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding ElevationMeters, StringFormat='{0:F0} m'}"
                                                       Style="{StaticResource GlassCaption}" FontSize="10" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" Padding="9,4" StrokeThickness="1" Stroke="#33FF6B7A"
                                                    Background="#22FF6B7A" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                <Label Text="{x:Static loc:AppStrings.StopRemove}" FontSize="12" TextColor="#FFC0C8" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveStopCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Route result card (tourist-map style): the live summary + one-tap "show it on the
                             map", which collapses this panel and frames the camera on the whole route. Shown
                             only once a route is actually drawn. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPlannedRoute}">
                            <Border Style="{StaticResource GlassBar}" Padding="12,9">
                                <Label Text="{Binding RouteSummary}" Style="{StaticResource GlassLabel}"
                                       FontSize="14" HorizontalOptions="Center" />
                            </Border>
                            <Button Style="{StaticResource GlassButtonAccent}" Text="{x:Static loc:AppStrings.RouteShow}"
                                    Command="{Binding ShowRouteCommand}" />
                            <Button Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.RouteFilm}"
                                    Command="{Binding MakeRouteFilmCommand}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.RouteClearShort}"
                                    Command="{Binding ClearRouteCommand}" />
                            <Button Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.RouteGpxShort}"
                                    Command="{Binding ExportRouteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- 🎚️ TRYBY -->
            <Border x:Name="PanelTryby" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                <ScrollView MaximumHeightRequest="600">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static loc:AppStrings.SectionModesTitle}" Style="{StaticResource GlassTitle}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.ToggleOrtho}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowOrtho}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="{x:Static loc:AppStrings.ToggleRock}" Style="{StaticResource GlassLabel}" />
                            <Label Text="{x:Static loc:AppStrings.ToggleRockHint}" Style="{StaticResource GlassCaption}" FontSize="10" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding RockMaterialOn}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="{x:Static loc:AppStrings.ToggleBiomes}" Style="{StaticResource GlassLabel}" />
                            <Label Text="{x:Static loc:AppStrings.ToggleBiomesHint}" Style="{StaticResource GlassCaption}" FontSize="10" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding BiomeMaterialOn}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="{x:Static loc:AppStrings.ToggleSlopeMap}" Style="{StaticResource GlassLabel}" />
                            <Label Text="{x:Static loc:AppStrings.ToggleSlopeMapHint}" Style="{StaticResource GlassCaption}" FontSize="10" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding SlopeMapMode}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.ToggleTrails}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowTrails}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.ToggleRoads}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowRoads}" />
                    </Grid>

                    <Label Text="{x:Static loc:AppStrings.TrailColoursHeader}" Style="{StaticResource GlassCaption}" Margin="0,2,0,0" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourRedEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CCDC2626|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailRed" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.ColourRed}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourBlueEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CC2563EB|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailBlue" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.ColourBlue}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourGreenEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CC16A34A|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailGreen" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.ColourGreen}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourYellowEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CCEAB308|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailYellow" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.ColourYellow}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding TrailColourBlackEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#CC111111|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="TrailBlack" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.ColourBlack}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>

                    <Label Text="{x:Static loc:AppStrings.LayersHeader}" Style="{StaticResource GlassCaption}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowTrails, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="Trails" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.LayerTrails}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowPeakNames, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PeakNames" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.LayerPeakNames}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowNightSky, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="NightSky" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.LayerNightSky}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowContours, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="Contours" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.LayerContours}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>

                    <!-- Peak-name label radius: only summits within this camera distance show a name. Sits right
                         under the "Nazwy szczytów" toggle and appears only while that layer is on. -->
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10" IsVisible="{Binding ShowPeakNames}">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.PeakRangeLabel}" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="1000" Maximum="80000"
                                Value="{Binding PeakLabelRadiusMeters, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.PeakRangeHint}" />
                        <Label Grid.Column="2" Text="{Binding PeakLabelRadiusText}" Style="{StaticResource GlassValue}" />
                    </Grid>

                    <Label Text="{x:Static loc:AppStrings.PoiHeader}" Style="{StaticResource GlassCaption}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowHuts, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiHuts" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiHuts}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowWildernessHuts, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiWilderness" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiWilderness}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowChalets, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiChalets" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiChalets}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowShelters, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiShelters" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiShelters}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowViewpoints, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiViewpoints" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiViewpoints}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowParking, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiParking" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiParking}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding ShowPasses, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="PoiPasses" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.PoiPasses}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- 🌦️ POGODA -->
            <Border x:Name="PanelPogoda" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=5}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{x:Static loc:AppStrings.SectionWeatherTitle}" Style="{StaticResource GlassTitle}" />
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.WeatherTime}" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="24"
                                Value="{Binding TimeOfDayHours, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.WeatherTimeHint}" />
                        <Label Grid.Column="2" Text="{Binding TimeOfDayHours, Converter={StaticResource HoursToClock}}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.WeatherClouds}" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Cloudiness, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.WeatherCloudsHint}" />
                        <Label Grid.Column="2" Text="{Binding Cloudiness, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.WeatherWind}" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Wind, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.WeatherWindHint}" />
                        <Label Grid.Column="2" Text="{Binding Wind, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.WeatherSnow}" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Snow, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.WeatherSnowHint}" />
                        <Label Grid.Column="2" Text="{Binding Snow, StringFormat='{0:P0}'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 🎥 WIDOK -->
            <Border x:Name="PanelWidok" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=3}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{x:Static loc:AppStrings.SectionViewTitle}" Style="{StaticResource GlassTitle}" />
                    <Grid ColumnDefinitions="64,*,52" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.ViewVertical}" Style="{StaticResource GlassLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="1" Maximum="5"
                                Value="{Binding VerticalExaggeration, Mode=TwoWay}" SemanticProperties.Hint="{x:Static loc:AppStrings.LabelVerticalExaggeration}" />
                        <Label Grid.Column="2" Text="{Binding VerticalExaggeration, StringFormat='{0:F1}×'}" Style="{StaticResource GlassValue}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.ViewResetCamera}" Clicked="OnResetCameraClicked" />
                        <Button Grid.Column="1" Style="{StaticResource GlassButtonAccent}" Text="{x:Static loc:AppStrings.ViewFlythrough}" Clicked="OnFlyThroughClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 🗺️ MAPA (data: regions, terrain loads, viewport downloads) -->
            <Border x:Name="PanelMapa" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=4}">
                <!-- Scrollable: the Mapa panel carries the GUGiK / offline buttons and the
                     download-for-view group, so cap its height and let it scroll. -->
                <ScrollView MaximumHeightRequest="600">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static loc:AppStrings.SectionMapTitle}" Style="{StaticResource GlassTitle}" />

                    <!-- The old "LOD demo" button is gone: the full LOD pipeline (ring base + 1 m
                         streaming) auto-starts with the map — see AutoStartLodPipeline in the VM. -->

                    <Label Text="{x:Static loc:AppStrings.MapRegionsHeader}" Style="{StaticResource GlassCaption}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionTatryEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionTatry" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.RegionTatry}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionBeskidyEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionBeskidy" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.RegionBeskidy}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionPieninyEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionPieniny" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.RegionPieniny}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                        <Border Padding="11,6" StrokeThickness="1" Stroke="#22FFFFFF" Margin="0,0,6,6"
                                Background="{Binding RegionBieszczadyEnabled, Converter={StaticResource BoolToBrush}, ConverterParameter='#5536E2FF|#14FFFFFF'}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleFlagCommand}" CommandParameter="RegionBieszczady" /></Border.GestureRecognizers>
                            <Label Text="{x:Static loc:AppStrings.RegionBieszczady}" Style="{StaticResource GlassLabel}" FontSize="12" />
                        </Border>
                    </FlexLayout>

                    <Border Padding="12,9" StrokeThickness="1" Stroke="#3536E2FF" Margin="0,2,0,0"
                            Background="#2236E2FF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding LoadTatraRegionCommand}" /></Border.GestureRecognizers>
                        <Label Text="{x:Static loc:AppStrings.MapLoadTerrain}" Style="{StaticResource GlassLabel}"
                               FontSize="13" HorizontalOptions="Center" />
                    </Border>

                    <Border Padding="12,9" StrokeThickness="1" Stroke="#353CE27A" Margin="0,2,0,0"
                            Background="#223CE27A">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDownloadTatraOfflineTapped" /></Border.GestureRecognizers>
                        <Label Text="{x:Static loc:AppStrings.MapDownloadOffline}" Style="{StaticResource GlassLabel}"
                               FontSize="13" HorizontalOptions="Center" />
                    </Border>

                    <Border Padding="12,9" StrokeThickness="1" Stroke="#35B69CFF" Margin="0,2,0,0"
                            Background="#22B69CFF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDownloadDataPackagesTapped" /></Border.GestureRecognizers>
                        <Label Text="{x:Static loc:AppStrings.MapDownloadPackages}" Style="{StaticResource GlassLabel}"
                               FontSize="13" HorizontalOptions="Center" />
                    </Border>

                    <Label Text="{x:Static loc:AppStrings.MapDownloadForViewHeader}" Style="{StaticResource GlassCaption}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadTrails}"
                                Command="{Binding DownloadTrailsForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadRoads}"
                                Command="{Binding DownloadRoadsForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadClimbing}"
                                Command="{Binding DownloadClimbingForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.DownloadPois}"
                                Command="{Binding DownloadPoisForViewportCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <Label Text="{x:Static loc:AppStrings.MapRouteHeader}" Style="{StaticResource GlassCaption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.ClearRoute}"
                                Command="{Binding ClearRouteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.ExportGpx}"
                                Command="{Binding ExportRouteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- ⚙️ USTAWIENIA (backend wired in a later stage) -->
            <Border x:Name="PanelUstawienia" Style="{StaticResource GlassSurface}" Padding="16,14"
                    IsVisible="{Binding ActiveSection, Converter={StaticResource IntEquals}, ConverterParameter=6}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static loc:AppStrings.SectionSettingsTitle}" Style="{StaticResource GlassTitle}" />

                    <Label Text="{x:Static loc:AppStrings.SettingsLanguageHeader}" Style="{StaticResource GlassCaption}" />
                    <!-- Language selector: Polski / English. Switching persists the choice and soft-restarts
                         the UI (SelectLanguageCommand → LanguageIndex → App.SwitchLanguage). -->
                    <Border Padding="4" BackgroundColor="#14FFFFFF" StrokeThickness="1" Stroke="#22FFFFFF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Grid Grid.Column="0" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="0" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding LanguageIndex, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="Polski" Style="{StaticResource GlassLabel}" FontSize="13" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                            <Grid Grid.Column="1" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="1" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding LanguageIndex, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="English" Style="{StaticResource GlassLabel}" FontSize="13" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,2" />

                    <Label Text="{x:Static loc:AppStrings.SettingsQualityHeader}" Style="{StaticResource GlassCaption}" />
                    <Border Padding="4" BackgroundColor="#14FFFFFF" StrokeThickness="1" Stroke="#22FFFFFF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Grid Grid.Column="0" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectQualityCommand}" CommandParameter="0" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding RenderQuality, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="{x:Static loc:AppStrings.QualityPerformance}" Style="{StaticResource GlassLabel}" FontSize="12" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                            <Grid Grid.Column="1" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectQualityCommand}" CommandParameter="1" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding RenderQuality, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="{x:Static loc:AppStrings.QualityBalanced}" Style="{StaticResource GlassLabel}" FontSize="12" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                            <Grid Grid.Column="2" Padding="0,8">
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectQualityCommand}" CommandParameter="2" /></Grid.GestureRecognizers>
                                <Border Background="{StaticResource GlassAccentFill}" Stroke="{StaticResource GlassAccentBrush}" StrokeThickness="1"
                                        IsVisible="{Binding RenderQuality, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                </Border>
                                <Label Text="{x:Static loc:AppStrings.QualityHigh}" Style="{StaticResource GlassLabel}" FontSize="12" HorizontalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Label Text="{x:Static loc:AppStrings.QualityHint}"
                           Style="{StaticResource GlassCaption}" />

                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,2" />

                    <Label Text="{x:Static loc:AppStrings.SettingsCacheHeader}" Style="{StaticResource GlassCaption}" />
                    <Label Text="{Binding CacheSummary}" Style="{StaticResource GlassLabel}" FontSize="12" />
                    <Button Style="{StaticResource GlassButton}" Text="{x:Static loc:AppStrings.SettingsClearCache}"
                            Command="{Binding ClearCacheCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,2" />

                    <Label Text="{x:Static loc:AppStrings.SettingsDebugHeader}" Style="{StaticResource GlassCaption}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.SettingsFpsOverlay}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowDebugOverlay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.SettingsVerboseLogs}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding VerboseLogging}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static loc:AppStrings.SettingsLodDiagnostics}" Style="{StaticResource GlassLabel}" />
                        <Switch Grid.Column="1" Style="{StaticResource GlassSwitch}" IsToggled="{Binding ShowLodDiagnostics}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- ON-MAP busy + status pill (the ONLY one — the old settings-stack twin showed alongside it).
             Driven by IsStatusPillVisible, not IsBusy: pops on every status change and LINGERS a few
             seconds after the work ends, so the final success/error message is actually readable. -->
        <Border Style="{StaticResource GlassBar}" Padding="14,8"
                HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,96"
                InputTransparent="True"
                IsVisible="{Binding IsStatusPillVisible}">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource GlassAccent}"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource GlassCaption}" MaximumWidthRequest="300" LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>
        </Border>

        <!-- Quiet "LOD active" badge: permanent proof the 1 m detail streaming is on (the LOD scene looks
             almost identical to the plain map, so without this there is no way to tell from the screen). -->
        <Border Style="{StaticResource GlassBar}" Padding="10,5"
                HorizontalOptions="Start" VerticalOptions="End" Margin="12,0,0,48"
                InputTransparent="True"
                IsVisible="{Binding IsLodStreaming}">
            <Label Text="{Binding LodBadgeText}" Style="{StaticResource GlassCaption}" />
        </Border>

        <!-- Marker details card: styled popup shown when a POI / climbing marker is tapped. -->
        <Grid IsVisible="{Binding IsMarkerPopupVisible}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMarkerPopupCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource GlassSurface}" HorizontalOptions="Center" VerticalOptions="Center"
                    Margin="24" Padding="0"
                    MinimumWidthRequest="280" MaximumWidthRequest="420">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding MarkerPopupTitle}" Style="{StaticResource GlassTitle}" FontSize="17" />
                        <Button Grid.Column="1" Text="✕" FontSize="15" Padding="0"
                                WidthRequest="34" HeightRequest="34" CornerRadius="17"
                                BackgroundColor="#1FFFFFFF" TextColor="{StaticResource GlassInk}"
                                Command="{Binding CloseMarkerPopupCommand}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#22FFFFFF" />
                    <VerticalStackLayout Padding="18,12" Spacing="8"
                                         BindableLayout.ItemsSource="{Binding MarkerPopupLines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="markers:MarkerPopupLine">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource GlassCaption}" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding Value}" Style="{StaticResource GlassLabel}" FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
