<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:vm="clr-namespace:MapaTur.App.ViewModels"
             xmlns:loc="clr-namespace:MapaTur.App.Localization"
             xmlns:views="clr-namespace:MapaTur.App.Views"
             x:Class="MapaTur.App.Views.MapPage"
             x:DataType="vm:MapPageViewModel"
             Title="{x:Static loc:AppStrings.AppTitle}">

    <!-- Mobile-tuned compaction for the two top toolbars. Phone idiom gets smaller fonts,
         padding and a scaled-down checkbox so the row fits more controls without horizontal
         scrolling; Desktop keeps the default MAUI sizes. Explicit x:Key (rather than implicit
         TargetType) so we don't accidentally shrink the on-screen 3D arrow pad too. -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Default="13" Phone="10" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="Thickness" Default="12,6" Phone="6,3" />
                    </Setter.Value>
                </Setter>
                <Setter Property="HeightRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Default="-1" Phone="30" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolbarCheckBox" TargetType="CheckBox">
                <Setter Property="Scale">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Default="1.0" Phone="0.7" />
                    </Setter.Value>
                </Setter>
                <Setter Property="WidthRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Default="-1" Phone="28" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolbarLabel" TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Default="14" Phone="10" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- ScrollView wrapper so the toolbar stays usable on portrait phones where the full button
             row is wider than the screen. Without it the 3D Mode / Track me buttons run off the right
             edge and become untappable. Horizontal-only scrolling keeps the vertical layout intact. -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#1F1F23}">
        <HorizontalStackLayout Padding="12" Spacing="8">
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.DownloadTrails}"
                    Command="{Binding DownloadTrailsForViewportCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.DownloadTrails}" />
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.DownloadClimbing}"
                    Command="{Binding DownloadClimbingForViewportCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.DownloadClimbing}" />
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.DownloadPois}"
                    Command="{Binding DownloadPoisForViewportCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.DownloadPois}" />
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.DownloadRoads}"
                    Command="{Binding DownloadRoadsForViewportCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.DownloadRoads}" />
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.ClearRoute}"
                    Command="{Binding ClearRouteCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.ClearRoute}" />
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.ExportGpx}"
                    Command="{Binding ExportRouteCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.ExportGpx}" />
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{x:Static loc:AppStrings.Toggle3D}"
                    Command="{Binding Toggle3DCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.Toggle3D}" />
            <!-- Live GPS dot toggle: label flips between "Track me" / "Stop tracking" via the
                 IsLocationTracking flag, so users always see what the next click will do. -->
            <Button Style="{StaticResource ToolbarButton}"
                    Text="{Binding IsLocationTracking, Converter={StaticResource LocationTrackingLabel}}"
                    Command="{Binding ToggleLocationTrackingCommand}"
                    SemanticProperties.Hint="{x:Static loc:AppStrings.ToggleLocationTrackingOn}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" />
        </HorizontalStackLayout>
        </ScrollView>

        <!-- Trail filter row: 5 PTTK colour toggles + 4 Karpat region toggles. Also scrollable so
             the POI / region toggles don't clip off a narrow screen. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#27272A}">
        <HorizontalStackLayout Padding="12,4" Spacing="2">
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowTrails}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Szlaki" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowRoads}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Drogi" />
            <BoxView WidthRequest="1" HeightRequest="22" Color="#52525B" Margin="6,0" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Kolory:" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding TrailColourRedEnabled}" Color="#DC2626" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Cz" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding TrailColourBlueEnabled}" Color="#2563EB" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Nb" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding TrailColourGreenEnabled}" Color="#16A34A" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Zi" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding TrailColourYellowEnabled}" Color="#EAB308" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Żo" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding TrailColourBlackEnabled}" Color="#27272A" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Cn" />
            <BoxView WidthRequest="1" HeightRequest="22" Color="#52525B" Margin="6,0" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Obszary:" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding RegionTatryEnabled}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Tatry" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding RegionBeskidyEnabled}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Beskidy" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding RegionPieninyEnabled}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Pieniny" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding RegionBieszczadyEnabled}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Bieszczady" />
            <BoxView WidthRequest="1" HeightRequest="22" Color="#52525B" Margin="6,0" />
            <Label Style="{StaticResource ToolbarLabel}" Text="POI:" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowHuts}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Schroniska" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowWildernessHuts}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Bacówki" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowChalets}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Chaty" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowShelters}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Wiaty" />
            <CheckBox Style="{StaticResource ToolbarCheckBox}" IsChecked="{Binding ShowViewpoints}" />
            <Label Style="{StaticResource ToolbarLabel}" Text="Widoki" />
        </HorizontalStackLayout>
        </ScrollView>

        <mapsui:MapControl x:Name="MapControl"
                           Grid.Row="2"
                           Map="{Binding Map}"
                           IsVisible="{Binding Is3DMode, Converter={StaticResource InverseBool}}"
                           SemanticProperties.Description="{x:Static loc:AppStrings.AccessibilityMapControl}" />

        <views:Terrain3DView x:Name="TerrainView"
                             Grid.Row="2"
                             Tiles="{Binding TerrainTiles}"
                             Raster="{Binding TerrainRaster}"
                             Trails="{Binding Trails3DOverlay}"
                             Roads="{Binding Roads3DOverlay}"
                             Route="{Binding Route3DOverlay}"
                             ClimbingAreas="{Binding Climbing3DOverlay}"
                             Pois="{Binding Pois3DOverlay}"
                             Peaks="{Binding Peaks3DOverlay}"
                             OrthoTexturePath="{Binding OrthoTexturePath}"
                             OrthoTexturePaths="{Binding OrthoTexturePaths}"
                             OrthoTextureCells="{Binding OrthoTextureCells}"
                             UserLocation="{Binding UserLocation}"
                             Atmosphere="{Binding Atmosphere}"
                             CameraState="{Binding CameraState, Mode=TwoWay}"
                             IsVisible="{Binding Is3DMode}" />

        <!-- 3D control sliders, overlaid on the top-left of the terrain view. Moved out of the
             horizontal toolbar ScrollView: a horizontal slider inside a horizontal scroller fought
             the scroll gesture, making them awkward to drag. Here there's no scroll to compete with.
             Compact: short tracks, small fonts, semi-transparent backdrop for legibility. -->
        <VerticalStackLayout Grid.Row="2"
                             HorizontalOptions="Start" VerticalOptions="Start"
                             Margin="8" Padding="8,6" Spacing="2"
                             BackgroundColor="#A0101418"
                             IsVisible="{Binding Is3DMode}">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="Pion:" TextColor="White" FontSize="11" WidthRequest="44" VerticalOptions="Center" />
                <Slider Minimum="1" Maximum="5" WidthRequest="120" VerticalOptions="Center"
                        Value="{Binding VerticalExaggeration, Mode=TwoWay}"
                        SemanticProperties.Hint="{x:Static loc:AppStrings.LabelVerticalExaggeration}" />
                <Label Text="{Binding VerticalExaggeration, StringFormat='{0:F1}×'}" TextColor="White" FontSize="11" WidthRequest="36" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="Czas:" TextColor="White" FontSize="11" WidthRequest="44" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="24" WidthRequest="120" VerticalOptions="Center"
                        Value="{Binding TimeOfDayHours, Mode=TwoWay}"
                        SemanticProperties.Hint="Pora dnia" />
                <Label Text="{Binding TimeOfDayHours, StringFormat='{0:F1}h'}" TextColor="White" FontSize="11" WidthRequest="36" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="Chmury:" TextColor="White" FontSize="11" WidthRequest="44" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="1" WidthRequest="120" VerticalOptions="Center"
                        Value="{Binding Cloudiness, Mode=TwoWay}"
                        SemanticProperties.Hint="Zachmurzenie" />
                <Label Text="{Binding Cloudiness, StringFormat='{0:P0}'}" TextColor="White" FontSize="11" WidthRequest="36" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Label Grid.Row="3"
               Padding="12,8"
               Text="{Binding StatusMessage}"
               BackgroundColor="{AppThemeBinding Light=#F4F4F5, Dark=#1F1F23}"
               TextColor="{AppThemeBinding Light=#18181B, Dark=#FAFAFA}"
               SemanticProperties.HeadingLevel="Level2" />
    </Grid>

</ContentPage>
