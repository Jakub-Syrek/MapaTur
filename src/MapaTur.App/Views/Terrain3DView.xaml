<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:views="clr-namespace:MapaTur.App.Views"
             x:Class="MapaTur.App.Views.Terrain3DView">
    <ContentView.Resources>
        <!-- Camera-pad button: nearly invisible at rest so it doesn't cover the terrain, then
             "materialises" to full opacity on hover (desktop) or press (touch) via the
             VisualStateManager. Cam3DSmallButton inherits all of this and only overrides its size. -->
        <Style x:Key="Cam3DButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="46" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="BackgroundColor" Value="#C0202830" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BorderColor" Value="#90FFFFFF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="Opacity" Value="0.20" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.20" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <!-- Compact variant for the two tilt arrows — same transparency/materialise behaviour,
             just smaller so they tuck between the full-size pan buttons in the centre column. -->
        <Style x:Key="Cam3DSmallButton" TargetType="Button" BasedOn="{StaticResource Cam3DButton}">
            <Setter Property="WidthRequest">
                <Setter.Value>
                    <OnIdiom x:TypeArguments="x:Double" Default="34" Phone="28" />
                </Setter.Value>
            </Setter>
            <Setter Property="HeightRequest">
                <Setter.Value>
                    <OnIdiom x:TypeArguments="x:Double" Default="34" Phone="28" />
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize">
                <Setter.Value>
                    <OnIdiom x:TypeArguments="x:Double" Default="15" Phone="13" />
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius">
                <Setter.Value>
                    <OnIdiom x:TypeArguments="x:Int32" Default="17" Phone="14" />
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="Cam3DCaption" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="#90000000" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid>
        <skia:SKGLView x:Name="Canvas" PaintSurface="OnPaintSurface">
            <skia:SKGLView.GestureRecognizers>
                <!-- Cesium-style minimal gesture set, no conflicts:
                     • 1-finger drag = PAN (map follows the finger) — standard for every terrain
                       map app (Google Maps, Cesium, Mapbox). The "rotate" semantics live on the
                       dedicated orbit-gizmo widget instead, where there is no risk of confusing
                       a finger drag for either rotation or translation.
                     • Pinch = zoom (already works).
                     • 2-finger drag is intentionally unbound — MAUI has no rotation gesture
                       recogniser, so any 2-finger pan would just race the pinch recogniser and
                       cause the dead-pinch / surprise-pan bugs we already fixed once.  -->
                <PanGestureRecognizer TouchPoints="1" PanUpdated="OnMeshPan" />
                <PinchGestureRecognizer PinchUpdated="OnPinch" />
                <!-- A discrete tap (distinct from the pan drag) selects a POI / climbing marker and
                     raises MarkerTapped so the host page can show a details popup. -->
                <TapGestureRecognizer Tapped="OnCanvasTapped" />
            </skia:SKGLView.GestureRecognizers>
        </skia:SKGLView>

        <!-- The cinematic Orla Perć fly-through button was removed from the UI; the scripted flight
             itself is kept (Terrain3DView.StartOrlaPercFlight) for later re-exposure. -->

        <!-- Camera-altitude (raise / lower) pad, bottom-LEFT. Orbit + zoom live on touch gestures
             (1-finger drag = orbit, pinch = zoom), translation is on the bottom-right pad. Altitude
             is the one camera dimension that's awkward to reach via a 2D screen gesture, so it
             keeps its own tappable column. -->
        <VerticalStackLayout x:Name="AltitudePad" HorizontalOptions="Start" VerticalOptions="End"
                             Margin="12" Spacing="4" InputTransparent="False">
            <Label Text="Wys." Style="{StaticResource Cam3DCaption}" />
            <Button Text="&#x25B2;" Pressed="OnRaiseClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
            <Button Text="&#x25BC;" Pressed="OnLowerClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
        </VerticalStackLayout>

        <!-- Pan + tilt + slow-rotate pad, bottom-right. The centre column stacks, top→bottom:
             pan-forward (▲), tilt-view-up-to-sky (⤒), tilt-view-down-to-ground (⤓), pan-back (▼)
             — so the two tilt controls sit between the forward/back pan as the user asked. The
             top row flanks ▲ with the in-place rotate arrows (⟲ ⟳); ◀ ▶ flank the tilt-up row.
             Tilt is clamped in ApplyOrbit (pitch ∈ [20°, ~90°]) so the camera can't fly under the
             terrain or past straight-down. -->
        <VerticalStackLayout x:Name="PanTiltPad" HorizontalOptions="End" VerticalOptions="End"
                             Margin="12" Spacing="4" InputTransparent="False">
            <Grid ColumnSpacing="4" RowSpacing="4"
                  ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <Button Grid.Row="0" Grid.Column="0" Text="&#x21BA;" Pressed="OnRotateLeftSlowClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="0" Grid.Column="1" Text="&#x25B2;" Pressed="OnPanUpClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="0" Grid.Column="2" Text="&#x21BB;" Pressed="OnRotateRightSlowClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="1" Grid.Column="0" Text="&#x25C0;" Pressed="OnPanLeftClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="1" Grid.Column="1" Text="&#x2912;" Pressed="OnLookUpClicked" Released="OnPadReleased" Style="{StaticResource Cam3DSmallButton}" />
                <Button Grid.Row="1" Grid.Column="2" Text="&#x25B6;" Pressed="OnPanRightClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="2" Grid.Column="1" Text="&#x2913;" Pressed="OnLookDownClicked" Released="OnPadReleased" Style="{StaticResource Cam3DSmallButton}" />
                <Button Grid.Row="3" Grid.Column="1" Text="&#x25BC;" Pressed="OnPanDownClicked" Released="OnPadReleased" Style="{StaticResource Cam3DButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentView>
