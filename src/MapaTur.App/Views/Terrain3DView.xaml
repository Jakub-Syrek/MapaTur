<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:views="clr-namespace:MapaTur.App.Views"
             x:Class="MapaTur.App.Views.Terrain3DView">
    <ContentView.Resources>
        <Style x:Key="Cam3DButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="46" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="BackgroundColor" Value="#C0202830" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BorderColor" Value="#90FFFFFF" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style x:Key="Cam3DCaption" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="#90000000" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid>
        <skia:SKGLView x:Name="Canvas" PaintSurface="OnPaintSurface">
            <skia:SKGLView.GestureRecognizers>
                <!-- Cesium-style minimal gesture set, no conflicts:
                     • 1-finger drag = PAN (map follows the finger) — standard for every terrain
                       map app (Google Maps, Cesium, Mapbox). The "rotate" semantics live on the
                       dedicated orbit-gizmo widget instead, where there is no risk of confusing
                       a finger drag for either rotation or translation.
                     • Pinch = zoom (already works).
                     • 2-finger drag is intentionally unbound — MAUI has no rotation gesture
                       recogniser, so any 2-finger pan would just race the pinch recogniser and
                       cause the dead-pinch / surprise-pan bugs we already fixed once.  -->
                <PanGestureRecognizer TouchPoints="1" PanUpdated="OnMeshPan" />
                <PinchGestureRecognizer PinchUpdated="OnPinch" />
            </skia:SKGLView.GestureRecognizers>
        </skia:SKGLView>

        <!-- Camera-altitude (raise / lower) pad, bottom-LEFT. Orbit + zoom live on touch gestures
             (1-finger drag = orbit, pinch = zoom), translation is on the bottom-right pad. Altitude
             is the one camera dimension that's awkward to reach via a 2D screen gesture, so it
             keeps its own tappable column. -->
        <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="End"
                             Margin="12" Spacing="4" InputTransparent="False">
            <Label Text="Wys." Style="{StaticResource Cam3DCaption}" />
            <Button Text="&#x25B2;" Clicked="OnRaiseClicked" Style="{StaticResource Cam3DButton}" />
            <Button Text="&#x25BC;" Clicked="OnLowerClicked" Style="{StaticResource Cam3DButton}" />
        </VerticalStackLayout>

        <!-- Orbit gizmo — sphere widget anchored to the bottom-LEFT just past the altitude
             column, so on a portrait phone it sits clearly left of the right-anchored Przesuń
             pad with no overlap. Drag the sphere to rotate the camera around its target; the
             red marker on the orb tracks the current azimuth. -->
        <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="End"
                             Margin="80,12,12,12" Spacing="4" InputTransparent="False">
            <Label Text="Obrót" Style="{StaticResource Cam3DCaption}" />
            <views:OrbitGizmoView x:Name="OrbitGizmo" />
        </VerticalStackLayout>

        <!-- Pan + slow-rotate pad, bottom-right. Centre column has the pan arrows (▲ ▼) and the
             rotate-in-place arrows (⟲ ⟳) in the centre row — small azimuth step per tap so the
             user can dial in the heading without overshooting. Rotate sits in the same cluster
             as pan so the navigation cross stays in one place. -->
        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End"
                             Margin="12" Spacing="4" InputTransparent="False">
            <Label Text="Przesuń" Style="{StaticResource Cam3DCaption}" />
            <Grid ColumnSpacing="4" RowSpacing="4"
                  ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <Button Grid.Row="0" Grid.Column="1" Text="&#x25B2;" Clicked="OnPanUpClicked" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="1" Grid.Column="0" Text="&#x25C0;" Clicked="OnPanLeftClicked" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="1" Grid.Column="2" Text="&#x25B6;" Clicked="OnPanRightClicked" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="2" Grid.Column="1" Text="&#x25BC;" Clicked="OnPanDownClicked" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="3" Grid.Column="0" Text="&#x21BA;" Clicked="OnRotateLeftSlowClicked" Style="{StaticResource Cam3DButton}" />
                <Button Grid.Row="3" Grid.Column="2" Text="&#x21BB;" Clicked="OnRotateRightSlowClicked" Style="{StaticResource Cam3DButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentView>
