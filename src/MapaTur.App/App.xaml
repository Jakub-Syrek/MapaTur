<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MapaTur.App"
             xmlns:converters="clr-namespace:MapaTur.App.Converters"
             x:Class="MapaTur.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/GlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:LocationTrackingLabelConverter x:Key="LocationTrackingLabel" />
            <converters:HoursToClockConverter x:Key="HoursToClock" />
            <converters:IntEqualsConverter x:Key="IntEquals" />
            <converters:IntToBoolConverter x:Key="IntToBool" />
            <converters:BoolToBrushConverter x:Key="BoolToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
